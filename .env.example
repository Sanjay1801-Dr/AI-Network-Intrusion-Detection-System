# ==============================================================================
# AI-Based Network Intrusion Detection System (NIDS) - Environment Configuration
# Phase 10: Production Configuration & Deployment Readiness
# ==============================================================================
# Copy this file to '.env' and update the values according to your environment.
# NEVER commit the actual '.env' file containing real secrets to version control.

# Application Environment (development | staging | production)
NIDS_ENVIRONMENT=development

# Database Persistence
# Local Development (SQLite):
NIDS_DATABASE_URL=sqlite:///./network_ids.db

# Production Deployment (PostgreSQL example):
# NIDS_DATABASE_URL=postgresql+psycopg2://ids_user:ids_secure_password@localhost:5432/nids_db

# Security & Operator Access Tokens (JWT)
# In production, must be at least 32 characters and NOT a placeholder.
NIDS_JWT_SECRET=CHANGE_ME_IN_DEVELOPMENT
NIDS_JWT_ALGORITHM=HS256
NIDS_JWT_EXPIRE_MINUTES=480

# CORS Configuration (Comma-separated list of allowed origins, NO wildcard '*' in production)
NIDS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Server Bind & Gateway
NIDS_HOST=127.0.0.1
NIDS_PORT=8000

# Logging & Operational Auditing (DEBUG | INFO | WARNING | ERROR | CRITICAL)
NIDS_LOG_LEVEL=INFO

# API Rate Limiting & Abuse Protection (Phase 11)
NIDS_RATE_LIMIT_ENABLED=true
NIDS_RATE_LIMIT_LOGIN=5/minute
NIDS_RATE_LIMIT_PREDICT=60/minute
NIDS_RATE_LIMIT_READ=120/minute
NIDS_RATE_LIMIT_MUTATION=30/minute

# ==============================================================================
# Optional: Initial Development Operator Provisioning (create_admin script)
# ==============================================================================
# NIDS_ADMIN_USERNAME=admin
# NIDS_ADMIN_PASSWORD=supply_secure_password_via_env
# NIDS_ANALYST_USERNAME=analyst
# NIDS_ANALYST_PASSWORD=supply_secure_password_via_env
# NIDS_VIEWER_USERNAME=viewer
# NIDS_VIEWER_PASSWORD=supply_secure_password_via_env
