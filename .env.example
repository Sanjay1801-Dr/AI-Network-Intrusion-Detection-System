# ==============================================================================
# AI-Based Network Intrusion Detection System (NIDS) - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and update the values according to your environment.
# NEVER commit the actual '.env' file containing real credentials to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI Network Intrusion Detection System"
APP_VERSION="1.0.0-phase1"

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Secrets (Generate strong random secrets for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
# Local Development (SQLite default):
DATABASE_URL=sqlite:///./network_ids.db

# Production (PostgreSQL example):
# DATABASE_URL=postgresql+psycopg2://ids_user:ids_secure_password@localhost:5432/nids_db
DB_ECHO_SQL=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Machine Learning Artifacts & Ingestion
MODEL_DIRECTORY=./machine-learning/models
ANOMALY_MODEL_FILENAME=isolation_forest_v1.joblib
CLASSIFIER_MODEL_FILENAME=threat_classifier_rf_v1.joblib
FEATURE_SCALER_FILENAME=feature_scaler_v1.joblib
CONFIDENCE_THRESHOLD=0.75
ANOMALY_CONTAMINATION=0.03

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/nids_system.log
ENABLE_AUDIT_LOGGING=True
